# Copy to .env and fill in real values for a real deployment.
# NEVER commit the filled-in file. Service-role keys and API keys must stay
# server-side only — nothing in this file is safe to expose to the browser.
#
# Every value below is OPTIONAL for local development: if you leave
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY unset, the Express gateway
# (server/db.ts) automatically falls back to an in-memory data store, and if
# you leave ANTHROPIC_API_KEY unset, Hermes brief/rule generation
# (server/lib/claude.ts) falls back to deterministic template text. The
# whole platform runs end-to-end with nothing configured — that's the demo
# mode. Fill these in only when you want real persistence and real Claude
# output.

# --- Express gateway (server/) --------------------------------------------
PORT=4000

# Supabase Postgres — leave both unset to use the in-memory fallback store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude — used for the Hermes investigation brief and rule
# synthesis. Leave unset to use template fallback text instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ML scoring microservice (ml-engine/main.py). If this is unreachable, the
# gateway automatically falls back to a structural heuristic rule instead
# of dropping the transaction (see server/lib/mlClient.ts).
ML_ENGINE_URL=http://localhost:8000
ML_ENGINE_TIMEOUT_MS=2000

# --- Vite frontend (src/) ---------------------------------------------------
# Base path the frontend calls for the API. In local dev, Vite proxies
# /api to VITE_API_PROXY_TARGET (see vite.config.ts) so you can usually
# leave VITE_API_BASE_URL at its default (/api/v1).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
