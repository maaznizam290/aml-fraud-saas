# Copy to .env.local (for app code) or .env (for local scripts/CLI) and fill in real values.
# NEVER commit the filled-in file. Service-role and DB credentials must stay server-side only.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never prefix with NEXT_PUBLIC_, never import from client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AI investigation / n8n orchestration (feature/n8n-orchestration) -----
# ORCHESTRATION_MODE=DEMO (default) uses deterministic synthetic data and an
# in-memory store — no secrets below are required or read. Set to REAL only
# for an actual deployment; REAL mode fails fast at startup if
# AML_WEBHOOK_SECRET or ANTHROPIC_API_KEY is missing. See docs/ORCHESTRATION.md.
ORCHESTRATION_MODE=DEMO

# Required in REAL mode only.
AML_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
CLAUDE_INVESTIGATION_MODEL=claude-sonnet-4-5

# Optional in REAL mode — the ML prediction service from feature/fraud-detection-engine.
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional in REAL mode — omit either to skip that notification channel entirely.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Optional fusion tuning (defaults shown) — see lib/orchestration/config.ts.
AML_ESCALATE_THRESHOLD=0.75
AML_REVIEW_THRESHOLD=0.4
