# Copy to .env.local (for app code) or .env (for local scripts/CLI) and fill in real values.
# NEVER commit the filled-in file. Service-role and DB credentials must stay server-side only.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never prefix with NEXT_PUBLIC_, never import from client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Populated by other feature branches — placeholders only, do not fill in on this branch
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
RESEND_API_KEY=
