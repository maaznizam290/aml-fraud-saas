{
  "name": "AML Case Resolution",
  "meta": {
    "description": "Fired when an analyst resolves a case (task section 9's final step: Alert -> Investigation -> Recommendation -> Human Review -> Case -> Resolution). Notifications on resolution are handled server-side (lib/orchestration/notifications/notifier.ts).",
    "instanceId": "aml-fraud-saas"
  },
  "nodes": [
    {
      "id": "webhook_trigger",
      "name": "case-resolution Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "path": "aml-case-resolution",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "call_resolve_api",
      "name": "Resolve Case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "notes": "POST /api/cases/:caseId/resolve — sets the case's terminal disposition and moves the alert to RESOLVED. Always analyst-driven; see lib/orchestration/humanReview.ts::resolveCase.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL + '/api/cases/' + $json.body.caseId + '/resolve' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { analystId: $json.body.analystId, disposition: $json.body.disposition, resolutionReason: $json.body.resolutionReason, priority: $json.body.priority } }}",
        "options": { "timeout": 15000, "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}"
      }
    }
  ],
  "connections": {
    "case-resolution Webhook": {
      "main": [[{ "node": "Resolve Case", "type": "main", "index": 0 }]]
    },
    "Resolve Case": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
